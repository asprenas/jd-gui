<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE RSyntaxTheme SYSTEM "theme.dtd">

<!--
   RSyntaxTextArea theme mimicking the current IntelliJ IDEA light scheme ("IntelliJ Light", New UI).
   Colors are approximations of the IDE defaults: keywords are blue and not bold, strings green,
   comments gray italic, soft yellow current line, light blue selection.
   The original JD-GUI eclipse.xml sets baseFont size 12; it is kept here to change colors only.
-->
<RSyntaxTheme version="1.0">

   <baseFont size="12"/>

   <!--  General editor colors. -->
   <background color="ffffff"/>
   <caret color="000000"/>
   <selection useFG="false" bg="a6d2ff" roundedEdges="false"/>
   <currentLineHighlight color="fcfaed" fade="false"/>
   <marginLine fg="ebecf0"/>
   <markAllHighlight color="f2e6a0"/>
   <markOccurrencesHighlight color="edebfc" border="false"/>
   <matchedBracket fg="000000" bg="93d9d9" highlightBoth="true" animate="false"/>
   <hyperlinks fg="2a6fdb"/>
   <secondaryLanguages>
      <language index="1" bg="f5f8fe"/>
      <language index="2" bg="f3faf3"/>
      <language index="3" bg="fdf3f3"/>
   </secondaryLanguages>

   <!-- Gutter styling. -->
   <gutterBackground color="ffffff"/>
   <gutterBorder color="ebecf0"/>
   <lineNumbers fg="aeb3c2" currentFG="767a8a"/>
   <foldIndicator fg="a8adbd" armedFg="6c707e" iconBg="ffffff"/>
   <iconRowHeader activeLineRange="3574f0"/>

   <!-- Syntax tokens. -->
   <tokenStyles>
      <style token="IDENTIFIER" fg="080808"/>
      <style token="RESERVED_WORD" fg="0033b3"/>
      <style token="RESERVED_WORD_2" fg="0033b3"/>
      <style token="ANNOTATION" fg="9e880d"/>
      <style token="COMMENT_DOCUMENTATION" fg="8c8c8c" italic="true"/>
      <style token="COMMENT_EOL" fg="8c8c8c" italic="true"/>
      <style token="COMMENT_MULTILINE" fg="8c8c8c" italic="true"/>
      <style token="COMMENT_KEYWORD" fg="8c8c8c" bold="true" italic="true"/>
      <style token="COMMENT_MARKUP" fg="8c8c8c" italic="true"/>
      <style token="DATA_TYPE" fg="0033b3"/>
      <!-- RSyntaxTextArea's Java highlighter uses FUNCTION for standard JDK class names (String, ArrayList, ...):
           IntelliJ does not color them -->
      <style token="FUNCTION" fg="080808"/>
      <style token="LITERAL_BOOLEAN" fg="0033b3"/>
      <style token="LITERAL_NUMBER_DECIMAL_INT" fg="1750eb"/>
      <style token="LITERAL_NUMBER_FLOAT" fg="1750eb"/>
      <style token="LITERAL_NUMBER_HEXADECIMAL" fg="1750eb"/>
      <style token="LITERAL_STRING_DOUBLE_QUOTE" fg="067d17"/>
      <style token="LITERAL_CHAR" fg="067d17"/>
      <style token="LITERAL_BACKQUOTE" fg="067d17"/>
      <style token="MARKUP_TAG_DELIMITER" fg="0033b3"/>
      <style token="MARKUP_TAG_NAME" fg="0033b3"/>
      <style token="MARKUP_TAG_ATTRIBUTE" fg="174ad4"/>
      <style token="MARKUP_TAG_ATTRIBUTE_VALUE" fg="067d17"/>
      <style token="MARKUP_COMMENT" fg="8c8c8c" italic="true"/>
      <style token="MARKUP_DTD" fg="8c8c8c"/>
      <style token="MARKUP_PROCESSING_INSTRUCTION" fg="8c8c8c"/>
      <style token="MARKUP_CDATA" fg="080808"/>
      <style token="MARKUP_CDATA_DELIMITER" fg="0033b3"/>
      <style token="MARKUP_ENTITY_REFERENCE" fg="1750eb"/>
      <style token="OPERATOR" fg="080808"/>
      <style token="PREPROCESSOR" fg="9e880d"/>
      <style token="REGEX" fg="067d17"/>
      <style token="SEPARATOR" fg="080808"/>
      <style token="VARIABLE" fg="871094"/>
      <style token="WHITESPACE" fg="080808"/>

      <style token="ERROR_IDENTIFIER" fg="080808" bg="ffdcdc"/>
      <style token="ERROR_NUMBER_FORMAT" fg="080808" bg="ffdcdc"/>
      <style token="ERROR_STRING_DOUBLE" fg="080808" bg="ffdcdc"/>
      <style token="ERROR_CHAR" fg="080808" bg="ffdcdc"/>
   </tokenStyles>

</RSyntaxTheme>
